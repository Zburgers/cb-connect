# Local/runtime configuration. Copy to an ignored .env.local and replace every
# placeholder with an environment-specific value. Never commit real values.

NODE_ENV=development
PORT=6050

# Convex client and deployment selection.
CONVEX_DEPLOYMENT=your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk client/server configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me
CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api-domain
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex deployment environment values. These are synced by the deploy workflow
# from protected GitHub environment secrets; they are not needed in PM2 config.
CLERK_WEBHOOK_SECRET=whsec_replace-me
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

# Middleware allowlist. Keep this explicit in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6050

# CI-only secret; do not place a real value in this file.
CONVEX_DEPLOY_KEY=replace-me

# Legacy aliases found in old local files; the current app does not consume them.
# Use NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL above instead.
# CONVEX_URL=
# CONVEX_SITE_URL=

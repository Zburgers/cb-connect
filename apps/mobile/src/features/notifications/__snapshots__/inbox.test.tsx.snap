exports[`mobile notification inbox contract > keeps read state explicit and action controls reachable in large-text layouts 1`] = `"<section><main><div><span>PRIVATE UPDATES</span><div><span role="header">Inbox</span></div><span>Private in-app updates appear here. Push delivery is not available in this build.</span><div><div></div><div><span aria-label="Read notification">READ</span></div><span role="header">Message activity</span><span>Open your partner space to view your messages.</span><span aria-label="Notification section: chat">Section: Chat</span><div><button aria-label="Open messages for Message activity"><span>Open messages</span></button><button aria-label="Dismiss Message activity"><span>Dismiss</span></button></div></div></div></main></section>"`;

# Production configuration for localhost:6000 deployment
# This file is for running the app in production mode on a local server

# Server port - Next.js will use PORT env var
PORT=6000

# Convex Cloud Deployment - Use your production deployment
CONVEX_DEPLOYMENT=prod:your-production-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-production-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=http://localhost:6000

# Clerk Authentication - Use your production keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your-publishable-key
CLERK_SECRET_KEY=sk_live_your-secret-key
CLERK_FRONTEND_API_URL=http://localhost:6000

# Clerk sign-in/sign-up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Node environment
NODE_ENV=production
